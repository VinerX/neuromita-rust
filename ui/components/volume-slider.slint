import { SandboxTheme } from "../sandbox/theme.slint";

export component VolumeSlider inherits Rectangle {
    in property <int> value;
    in property <bool> enabled: true;
    callback changed(int);
    height: 28px; min-width: 36px;
    accessible-role: slider; accessible-enabled: root.enabled;
    accessible-value: root.value; accessible-value-minimum: 0; accessible-value-maximum: 100; accessible-value-step: 1;
    accessible-action-increment => { if root.enabled { root.changed(min(100, root.value + 1)); } }
    accessible-action-decrement => { if root.enabled { root.changed(max(0, root.value - 1)); } }
    accessible-action-set-value(value) => { if root.enabled && value.is-float() { root.changed(round(clamp(value.to-float(), 0, 100))); } }
    forward-focus: focus;
    Rectangle { x: 9px; y: (parent.height - 5px) / 2; width: parent.width - 18px; height: 5px; border-radius: 2.5px; background: #ffffff1f;
        Rectangle { x: 0px; y: 0px; width: parent.width * root.value / 100; height: 100%; border-radius: 2.5px; background: SandboxTheme.accent; }
    }
    Rectangle { x: (parent.width - 18px) * root.value / 100; y: (parent.height - 18px) / 2; width: 18px; height: 18px; border-radius: 9px;
        background: root.enabled ? #f3edf6 : #848692; border-width: focus.has-focus ? 2px : 1px; border-color: SandboxTheme.accent;
    }
    focus := FocusScope { enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.changed(max(0, root.value - 1)); return accept; }
            if event.text == Key.RightArrow || event.text == Key.UpArrow { root.changed(min(100, root.value + 1)); return accept; }
            if event.text == Key.Home { root.changed(0); return accept; }
            if event.text == Key.End { root.changed(100); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer;
        clicked => { focus.focus(); root.changed(round(clamp((self.mouse-x - 9px) / (root.width - 18px) * 100, 0, 100))); }
        moved => { if self.pressed { root.changed(round(clamp((self.mouse-x - 9px) / (root.width - 18px) * 100, 0, 100))); } }
    }
}
