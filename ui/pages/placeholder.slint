import { Theme } from "../theme.slint";
import { Label, Icon, ActionSurface } from "../components/controls.slint";
import { I18n } from "../i18n.slint";

export component PlaceholderPage inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    callback home();
    background: Theme.background;
    VerticalLayout {
        padding: 28px; padding-top: 26px; spacing: 0px;
        Rectangle {
            height: 185px;
            border-radius: 22px; border-width: 1px; border-color: Theme.border;
            background: @linear-gradient(135deg, #171928f5, #0e101ff5);
            VerticalLayout {
                padding: 24px; spacing: 12px;
                HorizontalLayout {
                    height: 36px; padding: 0px; spacing: 13px;
                    VerticalLayout {
                        width: 23px; padding: 0px; alignment: center;
                        Icon { width: 23px; height: 23px; source: root.icon; colorize: Theme.accent-hover; }
                    }
                    Label { min-width: 0px; text: root.title; font-size: 26px; font-weight: 700; }
                }
                Label { height: 24px; min-width: 0px; text: I18n.i18n("placeholder.description", "Страница подготовлена для будущей реализации."); color: Theme.muted; }
                HorizontalLayout {
                    padding: 0px;
                    ActionSurface {
                        width: 140px; height: 38px; background: Theme.accent;
                        label: I18n.i18n("navigation.back-home", "На главную");
                        Label { text: parent.label; horizontal-alignment: center; font-weight: 700; }
                        activated => { root.home(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}
