import { Theme, Icons } from "../theme.slint";
import { Label, Icon, ActionSurface } from "../components/controls.slint";
import { I18n } from "../i18n.slint";

export struct ReleaseEntry {
    id: string, title: string, date: string, summary: string,
    details: string, url: string, prerelease: bool,
}

component ReleaseButton inherits ActionSurface {
    in property <string> caption;
    in property <image> symbol;
    in property <bool> primary: false;
    height: 37px;
    width: root.primary ? 112px : root.caption == I18n.i18n("releases.open-release", "Открыть релиз") ? 169px : 181px;
    label: root.caption;
    background: root.primary ? (root.pressed ? Theme.accent-pressed : root.hovered ? Theme.accent-hover : Theme.accent) : (root.hovered ? #ffffff16 : #ffffff0d);
    border-width: 1px;
    border-color: root.primary ? #82385899 : #252236e6;
    border-radius: 14px;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 7px; alignment: center;
        VerticalLayout {
            width: 14px; padding: 0px; alignment: center;
            Icon { width: 14px; height: 14px; source: root.symbol; colorize: root.primary ? white : Theme.icon; }
        }
        caption-text := Label { horizontal-stretch: 0; text: root.caption; color: root.primary ? white : Theme.text; font-size: 12px; font-weight: 700; }
    }
}

component ReleaseCard inherits Rectangle {
    in property <ReleaseEntry> release;
    in-out property <bool> expanded: false;
    callback open-url(string);
    height: root.expanded && root.release.details != "" ? 419px : 173px;
    border-radius: 22px; border-width: 1px; border-color: #1b1928eb;
    background: #0e101feb;
    VerticalLayout {
        padding: 18px; spacing: 10px;
        HorizontalLayout {
            height: 18px; spacing: 8px; padding: 0px; alignment: start;
            Rectangle {
                width: root.release.prerelease ? 115px : 71px; height: 19px;
                border-radius: 7px; background: root.release.prerelease ? #422258 : #792e56;
                Label { text: root.release.prerelease ? "PRE-RELEASE" : "RELEASE"; color: root.release.prerelease ? #ddccea : #f3dfe9; font-size: 10px; font-weight: 800; horizontal-alignment: center; }
            }
            Label { text: root.release.date; color: Theme.muted; font-size: 12px; horizontal-stretch: 0; }
            Rectangle { horizontal-stretch: 1; }
        }
        Label { height: 21px; text: root.release.title; font-size: 15px; font-weight: 700; }
        Rectangle { height: 1px; background: #ffffff0f; }
        if !root.expanded: ActionSurface {
            height: 20px; label: root.release.summary;
            Label { width: parent.width; text: root.release.summary == "" ? I18n.i18n("releases.no-description", "Без описания.") : root.release.summary; color: Theme.muted; font-size: 13px; overflow: elide; }
            activated => { if root.release.details != "" { root.expanded = true; } }
        }
        if root.expanded: Rectangle {
            height: 267px; background: #0000002e; border-width: 1px; border-color: Theme.border; border-radius: 12px; clip: true;
            Flickable {
                width: parent.width; height: parent.height;
                content-width: self.width;
                VerticalLayout { width: parent.width; padding-left: 12px; padding-right: 12px; padding-top: 10px; padding-bottom: 10px;
                    Text { text: root.release.details; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                }
            }
            VerticalLayout { padding-top: 6px; padding-right: 8px; padding-left: 8px; padding-bottom: 0px; alignment: start;
                HorizontalLayout { alignment: end; padding: 0px;
                    ActionSurface {
                        width: 28px; height: 28px; label: I18n.i18n("releases.collapse", "Свернуть");
                        Label { text: "×"; font-size: 20px; horizontal-alignment: center; }
                        activated => { root.expanded = false; }
                    }
                }
            }
        }
        HorizontalLayout {
            height: 35px; padding: 0px;
            ReleaseButton {
                caption: I18n.i18n("releases.open-release", "Открыть релиз");
                symbol: Icons.external-link;
                activated => { root.open-url(root.release.url); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

component SectionCaption inherits Label {
    font-size: 11px; font-weight: 800; color: Theme.muted; height: 23px;
}

export component ReleasesPage inherits Rectangle {
    in property <[ReleaseEntry]> prereleases;
    in property <[ReleaseEntry]> releases;
    in property <bool> loading;
    in property <string> error;
    in property <string> repository: "Atm4x/NeuroMita";
    in-out property <int> filter: 0;
    callback refresh();
    callback open-url(string);
    background: Theme.background;
    clip: true;
    Flickable {
        width: parent.width; height: parent.height;
        content-width: self.width;
        VerticalLayout {
            width: parent.width;
            padding-left: 28px; padding-right: 28px; padding-top: 26px; padding-bottom: 28px;
            spacing: 13px;
            Rectangle {
                height: 185px;
                border-radius: 22px; border-width: 1px; border-color: Theme.border;
                background: @linear-gradient(135deg, #171928f5, #0e101ff5);
                HorizontalLayout { padding: 0px; alignment: start;
                    Rectangle { width: 3px; border-radius: 2px; background: Theme.accent; }
                }
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    Label { height: 13px; text: "NEWS"; color: Theme.accent-hover; font-size: 10px; font-weight: 700; }
                    Label { height: 34px; text: I18n.i18n("page.releases.title", "Релизы NeuroMita"); font-size: 26px; font-weight: 700; }
                    Label {
                        height: 20px; min-width: 0px;
                        text: I18n.i18n("releases.subtitle-prefix", "Лента публичных релизов с GitHub (") + root.repository + I18n.i18n("releases.subtitle-suffix", "): changelog, бета-сборки и ссылки на полные заметки.");
                        color: Theme.muted; font-size: 13px;
                    }
                    HorizontalLayout {
                        height: 37px; spacing: 10px; padding: 0px;
                        ReleaseButton { caption: I18n.i18n("releases.refresh", "Обновить"); symbol: Icons.refresh; primary: true; activated => { root.refresh(); } }
                        ReleaseButton { caption: I18n.i18n("releases.github", "Открыть на GitHub"); symbol: Icons.github; activated => { root.open-url("https://github.com/" + root.repository + "/releases"); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if root.prereleases.length > 0 && root.releases.length > 0: HorizontalLayout {
                height: 38px; padding: 0px; spacing: 8px;
                for tab in [
                    { mode: 0, caption: I18n.i18n("releases.filter.all", "Все") },
                    { mode: 1, caption: I18n.i18n("releases.filter.release", "Релизы") },
                    { mode: 2, caption: I18n.i18n("releases.filter.pre", "Пререлизы") }
                ]: ActionSurface {
                    width: tab.mode == 2 ? 124px : 88px; label: tab.caption;
                    selected: root.filter == tab.mode;
                    background: self.selected ? Theme.selected : self.hovered ? Theme.hover : #ffffff08;
                    border-width: 1px; border-color: self.selected ? Theme.accent-border : Theme.border;
                    border-radius: 12px;
                    Label { text: tab.caption; font-size: 12px; font-weight: 700; horizontal-alignment: center; color: parent.selected ? Theme.text : Theme.muted; }
                    activated => { root.filter = tab.mode; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.loading: Rectangle {
                height: 80px; background: Theme.panel; border-radius: 20px; border-width: 1px; border-color: Theme.border;
                HorizontalLayout { padding-left: 20px; padding-right: 20px;
                    Label { text: I18n.i18n("releases.loading", "Загрузка релизов…"); color: Theme.muted; }
                }
            }
            if root.error != "": Rectangle {
                height: 76px; background: Theme.panel; border-radius: 18px; border-width: 1px; border-color: Theme.border;
                HorizontalLayout { padding-left: 18px; padding-right: 18px;
                    Label { text: root.error; color: Theme.warning; wrap: word-wrap; overflow: clip; }
                }
            }
            if !root.loading && root.error == "" && root.prereleases.length == 0 && root.releases.length == 0: Rectangle {
                height: 76px; background: Theme.panel; border-radius: 18px; border-width: 1px; border-color: Theme.border;
                HorizontalLayout { padding-left: 18px; padding-right: 18px;
                    Label { text: I18n.i18n("releases.empty", "Релизы пока не найдены."); color: Theme.muted; }
                }
            }
            if root.filter != 1 && root.prereleases.length > 0: VerticalLayout {
                padding: 0px; spacing: 12px;
                SectionCaption { text: I18n.i18n("releases.section.pre", "ПРЕРЕЛИЗЫ"); }
                for entry in root.prereleases: ReleaseCard {
                    release: entry; open-url(url) => { root.open-url(url); }
                }
            }
            if root.filter != 2 && root.releases.length > 0: VerticalLayout {
                padding: 0px; spacing: 12px;
                SectionCaption { text: I18n.i18n("releases.section.release", "РЕЛИЗЫ"); }
                for entry in root.releases: ReleaseCard {
                    release: entry; open-url(url) => { root.open-url(url); }
                }
            }
        }
    }
}
